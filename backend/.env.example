# ============================================================================
# AI-Research-OS 后端配置样例
# 复制为项目根目录（或 backend/ 下）的 .env 后按需修改。
# 所有变量均有默认值；核心 CRUD（论文/任务/项目/笔记/实验/对话/版本/搜索）
# 不依赖 LLM，仅“论文总结 / Chat / 多 Agent 协作”需要配置 LLM。
# ============================================================================

# ---------------------------------------------------------------------------
# LLM（OpenAI 兼容）配置 —— 任选其一，取消对应注释即可。
# 也可保持默认（全空），启动后在前端「设置 → LLM API 配置」中填写并即时生效。
# ---------------------------------------------------------------------------

# 方案 A：硅基流动 SiliconFlow（免费额度）
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_API_KEY=sk-你的key
# LLM_MODEL=deepseek-ai/DeepSeek-V3

# 方案 B：智谱 BigModel（有免费模型 glm-4-flash）
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_API_KEY=你的key
# LLM_MODEL=glm-4-flash

# 方案 C：本地 Ollama（完全免费、离线）
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b

# 方案 D：Agnes AI（免费，OpenAI 兼容）
# LLM_BASE_URL=https://apihub.agnes-ai.com/v1
# LLM_API_KEY=sk-你的AgnesKey
# LLM_MODEL=（留空，在设置页点「获取模型」选择）

# 以下参数对所有方案通用
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4000
LLM_TIMEOUT=120
# Base URL 已包含 /v1，所以 path 只需 /chat/completions（OpenAI SDK 风格）
LLM_HTTP_PATH=/chat/completions

# ---------------------------------------------------------------------------
# 数据库
# DB_PATH 优先；否则使用 <项目根>/data/ai_research_os.db
# ---------------------------------------------------------------------------
# DB_PATH=
# DATA_DIR=

# ---------------------------------------------------------------------------
# Agent 联网搜索（web_search 技能，2026-08-20 新增）
# 让 Chat Agent 与多 Agent 管线（architect→planner→reviewer）可调用 web_search。
# 默认走博查 Bocha（国内直连，bochaai.com 注册免费获取 key，含免费额度）；
# 未配置 key 或调用失败时自动降级 Wikipedia（零密钥，仅百科类内容）。
# ---------------------------------------------------------------------------
# WEB_SEARCH_PROVIDER=bocha        # 可选：bocha（默认）/ wikipedia
# BOCHA_API_KEY=sk-你的博查key

# ---------------------------------------------------------------------------
# Agent 工具审批（2026-08-21 新增，对齐 DeepSeek Harness 的工程纪律）
# 审批模式：
#   auto   （默认）敏感工具（create_* 写库）直接执行，危险工具（不可逆操作）拒绝
#   manual 敏感工具等待用户审批（前端弹窗），危险工具仍拒绝
#   strict 敏感与危险工具均等待用户审批
# AGENT_REQUIRE_APPROVAL_TOOLS：强制这些工具即使 auto 模式也要审批（逗号分隔）
# AGENT_APPROVAL_TIMEOUT：审批等待超时（秒），超时按拒绝处理
# ---------------------------------------------------------------------------
# AGENT_APPROVAL_MODE=auto
# AGENT_REQUIRE_APPROVAL_TOOLS=create_note,create_task
# AGENT_APPROVAL_TIMEOUT=300

# ---------------------------------------------------------------------------
# Agent 上下文管理（2026-08-21 新增）
# 多角色串联时消息会膨胀；超过预算后把早期历史用 LLM 压缩成摘要（不破坏
# tool 配对），替代粗暴的轮次截断。AGENT_MAX_TOOL_ROUNDS 仍保留为硬上限。
# ---------------------------------------------------------------------------
# AGENT_CONTEXT_TOKEN_LIMIT=24000
# AGENT_CONTEXT_KEEP_LAST=6
# AGENT_MAX_TOOL_ROUNDS=8

# ---------------------------------------------------------------------------
# 服务
# ---------------------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000

# CORS：开发默认 *（与旧行为一致）；生产请收紧为前端域名，逗号分隔。
CORS_ORIGINS=*
